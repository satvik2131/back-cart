# Copy to .env and adjust as needed:  cp .env.example .env

APP_ENV=development
APP_NAME=back-cart

# Postgres container credentials (consumed by the db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=back_cart

# Async SQLAlchemy URL used by the api service. The host must be the
# compose service name (db), not localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/back_cart
